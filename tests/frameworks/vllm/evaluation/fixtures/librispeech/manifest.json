      "file": "6930-75918-0006.flac",
      "sha256": "4bed112ebfdba58ec061abd3fe013f89946863e9c51e8a83b50a5eb7afb9ce65",
      "size": 120849,
      "sample_rate": 16000,
      "samples": 93600,
      "transcript": "THIS HAS INDEED BEEN A HARASSING DAY CONTINUED THE YOUNG MAN HIS EYES FIXED UPON HIS FRIEND"
