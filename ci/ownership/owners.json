{
  "schema_version": 1,
  "local_steward": "@AndreasKaratzas",
  "domains": {
    "stewardship": {
      "responsibility": "Repository direction, unresolved ownership and rollout decisions.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "api-runtime": {
      "responsibility": "Public semantics, preparation, native ABI, execution policy and compatibility.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "build": {
      "responsibility": "Wheel/native builds, compiler inputs, artifact packaging and generic JIT/AOT machinery.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "numerics": {
      "responsibility": "GEMM, quantization, normalization and numerical representations.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "attention": {
      "responsibility": "Attention, RoPE and state/cache layouts.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "moe": {
      "responsibility": "Routing, expert ordering and expert execution.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "collectives": {
      "responsibility": "Distributed execution, ordering, communicator and workspace lifetimes.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "clients": {
      "responsibility": "Framework bridges, pinned client environments and serving acceptance.",
      "primary": null,
      "backup": null,
      "accepted": false
    },
    "delivery": {
      "responsibility": "CI resources, evidence, release promotion, containers and cadence.",
      "primary": null,
      "backup": null,
      "accepted": false
    }
  },
  "rules": [
